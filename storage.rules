rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Todos los archivos bajo la ruta events/{eventId} son legibles públicamente
    match /events/{eventId}/{allPaths=**} {
      allow read: if true;
    }
    
    // Reglas de escritura específicas
    match /events/{eventId}/memories/{fileName} {
      // Los invitados no autenticados pueden subir recuerdos (crear nuevos archivos)
      // Limitamos el tamaño de subida a 200MB (209715200 bytes) y verificamos tipo de contenido
      allow create: if request.resource.size < 200 * 1024 * 1024
                    && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('video/.*'));
    }
    
    match /events/{eventId}/theme/{fileName} {
      // Solo el anfitrión/administrador autenticado puede crear, modificar o borrar elementos del tema
      allow write: if request.auth != null;
    }

    match /events/{eventId}/data/memoryImages/{fileName} {
      // Solo el anfitrión/administrador autenticado puede crear, modificar o borrar imágenes del juego de memoria
      allow write: if request.auth != null;
    }
  }
}
